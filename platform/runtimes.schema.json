{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asa.local/schemas/platform-runtimes.schema.json",
  "title": "Platform runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["chart", "reservedConfig"],
  "$defs": {
    "chartValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probeDefaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "failureThreshold": { "type": "integer", "minimum": 1 },
                "periodSeconds": { "type": "integer", "minimum": 1 }
              }
            },
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "initialDelaySeconds": { "type": "integer", "minimum": 0 },
                "periodSeconds": { "type": "integer", "minimum": 1 },
                "timeoutSeconds": { "type": "integer", "minimum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1 }
              }
            },
            "liveness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "initialDelaySeconds": { "type": "integer", "minimum": 0 },
                "periodSeconds": { "type": "integer", "minimum": 1 },
                "timeoutSeconds": { "type": "integer", "minimum": 1 },
                "failureThreshold": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "limits": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "tmp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": { "type": "string", "minLength": 1 }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "properties": {
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults"],
      "properties": {
        "defaults": { "$ref": "#/$defs/chartValues" },
        "workloads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "web": { "$ref": "#/$defs/chartValues" },
            "grpc": { "$ref": "#/$defs/chartValues" },
            "worker": { "$ref": "#/$defs/chartValues" },
            "scheduledJob": { "$ref": "#/$defs/chartValues" }
          }
        }
      }
    },
    "reservedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "prefixes"],
      "properties": {
        "exact": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prefixes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
